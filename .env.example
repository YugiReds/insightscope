# Copy this file to .env and put YOUR OWN values in. Every value below is a FAKE placeholder.
# .env is ignored by git. Never commit it, and never paste a real password or token into this example file.

# Postgres address. For Neon, copy the connection string from the Neon dashboard (it looks like this).
# postgres://, postgresql:// and postgresql+psycopg:// are all accepted; keep everything after the "?" as Neon gives it.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# For a local Postgres instead, it looks like this:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/insightscope

# Hugging Face token for the AI summaries. Optional: without it, summaries use the plain template.
HF_TOKEN=hf_your_token_here

# Optional: which model writes the summaries (this is the default).
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# A DATABASE_URL set in your shell (or by Render) wins over this file. For example, to load data into Neon from PowerShell:
#   $env:DATABASE_URL = "postgresql://...your real Neon address..."
#   .\venv\Scripts\python.exe ingest.py
#   .\venv\Scripts\python.exe ingest_recalls.py
