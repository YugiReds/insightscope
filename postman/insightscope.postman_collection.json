        {
          "name": "Monthly recall counts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('months are listed and each month adds up', function () {",
                  "    var months = pm.response.json().months;",
                  "    pm.expect(months).to.not.be.empty;",
                  "    months.forEach(function (m) {",
                  "        var sum = 0;",
                  "        Object.keys(m.by_classification).forEach(function (cls) { sum += m.by_classification[cls]; });",
                  "        pm.expect(sum).to.eql(m.total);",
                  "    });",
                  "});",
                  "",
                  "pm.test('the first month is the first fully covered month', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.months[0].month).to.eql(body.coverage.first_full_month);",
                  "});"
                ]
              }
            }
