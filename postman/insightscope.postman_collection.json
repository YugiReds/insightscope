                  "});",
                  "",
                  "// Remember the newest recall's number so 'Get recall by number' works on any data load.",
                  "pm.test('saved the first recall_number as sampleRecallNumber', function () {",
                  "    var first = pm.response.json().items[0];",
                  "    pm.expect(first.recall_number).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('sampleRecallNumber', first.recall_number);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recalls?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["recalls"],
              "query": [
                { "key": "limit", "value": "5" }
