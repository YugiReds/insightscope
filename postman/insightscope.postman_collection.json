          }
        },
        {
          "name": "Recall N/A reaches our code (200, or our own 404; never the generic Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The slash in 'N/A' must not stop the route. Either the recall is loaded (200) or our own",
                  "// 'No recall found' message comes back (404). FastAPI's generic 'Not Found' means the routing bug.",
                  "pm.test('200 with recall_number N/A, or 404 with our own message', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 404]);",
                  "    var body = pm.response.json();",
                  "    if (pm.response.code === 200) {",
                  "        pm.expect(body.recall_number).to.eql('N/A');",
                  "        pm.expect(body.product_ndcs).to.be.an('array');",
                  "    } else {",
                  "        pm.expect(body.detail).to.eql('No recall found with recall number N/A');",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/recalls/N/A",
              "host": ["{{baseUrl}}"],
              "path": ["recalls", "N", "A"]
            }
          }
        },
        {
          "name": "Recalls for an NDC (found in the recalls)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Only about 1 in 4 recalls lists any NDC, and the list does not show them, so look through the",
                  "// newest recalls one by one until one has an NDC. Saved as sampleRecallNdc.",
                  "pm.collectionVariables.unset('sampleRecallNdc');",
                  "var base = pm.collectionVariables.get('baseUrl');",
                  "pm.sendRequest(base + '/recalls?limit=40', function (err, res) {",
                  "    if (err || res.code !== 200) { return; }",
                  "    var numbers = res.json().items.map(function (r) { return r.recall_number; });",
                  "    function next(i) {",
                  "        if (i >= numbers.length) { return; }",
                  "        pm.sendRequest(base + '/recalls/' + encodeURI(numbers[i]), function (e, r) {",
                  "            var ndcs = (!e && r.code === 200) ? r.json().product_ndcs : [];",
                  "            if (ndcs.length > 0) {",
                  "                pm.collectionVariables.set('sampleRecallNdc', ndcs[0]);",
                  "            } else {",
                  "                next(i + 1);",
                  "            }",
                  "        });",
                  "    }",
                  "    next(0);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('product_ndc matches and there is at least one recall', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.product_ndc).to.eql(pm.collectionVariables.get('sampleRecallNdc'));",
                  "    pm.expect(body.total).to.be.at.least(1);",
                  "    pm.expect(body.items).to.have.lengthOf(Math.min(body.total, 5));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{sampleRecallNdc}}/recalls?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{sampleRecallNdc}}", "recalls"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
