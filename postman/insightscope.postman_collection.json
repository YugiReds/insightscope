{
  "info": {
    "name": "InsightScope API",
    "description": "Requests and tests for the InsightScope API. Start the API first (uvicorn main:app), then run the collection. The base URL is the collection variable baseUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" }
  ],
  "item": [
    {
      "name": "Happy path",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('status is ok', function () {",
                  "    pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        },
        {
          "name": "Database health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('database is reachable', function () {",
                  "    pm.expect(pm.response.json().database).to.eql('reachable');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["health", "db"]
            }
          }
        },
        {
          "name": "List products (limit 5)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('items has 5 entries', function () {",
                  "    pm.expect(pm.response.json().items).to.have.lengthOf(5);",
                  "});",
                  "",
                  "pm.test('total is a number', function () {",
                  "    pm.expect(pm.response.json().total).to.be.a('number');",
                  "});",
                  "",
                  "// Remember the first product's NDC so 'Get product by NDC' works on any data load.",
                  "pm.test('saved the first product_ndc as sampleNdc', function () {",
                  "    var first = pm.response.json().items[0];",
                  "    pm.expect(first.product_ndc).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('sampleNdc', first.product_ndc);",
                  "});",
                  "",
                  "// Remember the first labeler on the page that has a word of 3+ letters/digits, for the labeler filter.",
                  "pm.test('saved a labeler_name with a usable word as sampleLabeler', function () {",
                  "    var usable = pm.response.json().items.filter(function (p) {",
                  "        var runs = (p.labeler_name || '').toLowerCase().match(/[a-z0-9]+/g) || [];",
                  "        return runs.some(function (w) { return w.length >= 3; });",
                  "    });",
                  "    pm.expect(usable, 'no labeler_name on this page has a word of 3 or more letters/digits').to.not.be.empty;",
                  "    pm.collectionVariables.set('sampleLabeler', usable[0].labeler_name);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Filter products by dosage form (TABLET)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('every item has dosage_form TABLET', function () {",
                  "    var items = pm.response.json().items;",
                  "    pm.expect(items).to.not.be.empty;",
                  "    items.forEach(function (item) {",
                  "        pm.expect(item.dosage_form).to.eql('TABLET');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?dosage_form=TABLET&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "dosage_form", "value": "TABLET" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Filter products by labeler (longest word of a labeler from the list)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Longest run of letters and digits, lowercase: safe in a URL, and always a piece of the real name.",
                  "var name = (pm.collectionVariables.get('sampleLabeler') || '').toLowerCase();",
                  "var runs = name.match(/[a-z0-9]+/g) || [];",
                  "var longest = runs.reduce(function (best, w) { return w.length > best.length ? w : best; }, '');",
                  "pm.collectionVariables.set('sampleLabelerWord', longest);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('every item has the filter text in its labeler_name (any capitals)', function () {",
                  "    var word = pm.collectionVariables.get('sampleLabelerWord');",
                  "    pm.expect(word, 'sampleLabelerWord must be at least 3 characters').to.have.lengthOf.at.least(3);",
                  "    var items = pm.response.json().items;",
                  "    pm.expect(items).to.not.be.empty;",
                  "    items.forEach(function (item) {",
                  "        pm.expect(item.labeler_name.toLowerCase()).to.include(word);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products?labeler={{sampleLabelerWord}}&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["products"],
              "query": [
                { "key": "labeler", "value": "{{sampleLabelerWord}}" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Get product by NDC (from the list)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('has active_ingredients and packages lists', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.active_ingredients).to.be.an('array');",
                  "    pm.expect(body.packages).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('returns the NDC that was asked for', function () {",
                  "    pm.expect(pm.response.json().product_ndc).to.eql(pm.collectionVariables.get('sampleNdc'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/products/{{sampleNdc}}",
              "host": ["{{baseUrl}}"],
              "path": ["products", "{{sampleNdc}}"]
            }
          }
        },
