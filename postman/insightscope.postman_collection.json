        {
          "name": "Recall spikes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('threshold is 2 and months were scored', function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.threshold).to.eql(2);",
                  "    pm.expect(body.months_scored).to.be.above(0);",
                  "});",
                  "",
                  "pm.test('every spike is above the threshold and lists at most 3 reasons and 3 firms', function () {",
                  "    var body = pm.response.json();",
                  "    body.spikes.forEach(function (spike) {",
                  "        pm.expect(spike.z_score).to.be.above(body.threshold);",
                  "        pm.expect(spike.top_reason_categories.length).to.be.within(1, 3);",
                  "        pm.expect(spike.top_recalling_firms.length).to.be.within(1, 3);",
                  "    });",
                  "});"
