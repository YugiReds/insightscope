            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/analytics/recalls/spikes",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "recalls", "spikes"]
